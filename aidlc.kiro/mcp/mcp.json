{
  "mcpServers": {
    "aidlc.devsecops-cicd": {
      "command": "uvx",
      "args": ["aidlc.devsecops-cicd-mcp@latest"],
      "env": { "MCP_API_TOKEN": "${MCP_API_TOKEN}" },
      "disabled": false
    },
    "aidlc.html-creator": {
      "command": "uvx",
      "args": ["aidlc.html-creator-mcp@latest"],
      "env": { "MCP_API_TOKEN": "${MCP_API_TOKEN}" },
      "disabled": false
    },
    "aidlc.bpmn-creator": {
      "command": "uvx",
      "args": ["aidlc.bpmn-creator-mcp@latest"],
      "env": { "MCP_API_TOKEN": "${MCP_API_TOKEN}" },
      "disabled": false
    },
    "aidlc.deck-creator": {
      "command": "uvx",
      "args": ["aidlc.deck-creator-mcp@latest"],
      "env": { "MCP_API_TOKEN": "${MCP_API_TOKEN}" },
      "disabled": false
    }
  }
}
