8" width="28" height="28" as="geometry" /></mxCell><mxCell id="c28" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="38" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c29" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="298" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c30" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="558" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c31" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="988" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;Session tool cycle&lt;/b&gt;&lt;br&gt;Each step: &lt;b&gt;deck_step_get&lt;/b&gt; serves the instructions, the local assistant does the work in the workspace, then &lt;b&gt;deck_step_submit&lt;/b&gt; records the result.&lt;br&gt;At a gate: &lt;b&gt;deck_gate_confirm&lt;/b&gt; records the user&#x27;s decision before the next step unlocks.&lt;br&gt;Any time: &lt;b&gt;deck_session_status&lt;/b&gt; and &lt;b&gt;deck_run_log&lt;/b&gt;.&lt;br&gt;Read template text with &lt;b&gt;deck_text_map&lt;/b&gt;, write overrides.json." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);fillStyle=auto;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=12;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="50" y="670" width="980" height="120" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="1060" y="670" width="120" height="22" as="geometry" /></mxCell><mxCell id="c34" value="Step" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1060" y="700" width="80" height="34" as="geometry" /></mxCell><mxCell id="c35" value="Optional" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;dashed=1;dashPattern=6 4;fillColor=light-dark(#F5F9FC,#13202B);fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1155" y="700" width="80" height="34" as="geometry" /></mxCell><mxCell id="c36" value="Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF4E5,#3D2A00);fillStyle=auto;strokeColor=#FF9900;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="1250" y="696" width="70" height="44" as="geometry" /></mxCell><mxCell id="c37" value="Start / end" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fill