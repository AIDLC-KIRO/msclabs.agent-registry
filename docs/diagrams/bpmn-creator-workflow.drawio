<mxfile host="drawio" agent="aws-architecture-diagram"><diagram id="bpmn-creator-workflow" name="bpmn-creator-workflow"><mxGraphModel dx="1280" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="Start&lt;div style=&quot;font-weight: normal; font-size: 11px;&quot;&gt;bpmn_start&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fillStyle=auto;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="50" y="213" width="140" height="64" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;Explore workspace&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Review existing local sources&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="200" height="110" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Scope&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Confirm known context, list the information gaps&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="510" y="190" width="200" height="110" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Interview&lt;/b&gt; &lt;i&gt;(optional)&lt;/i&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Collect knowledge from the people in the process&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;dashed=1;dashPattern=6 4;fillColor=light-dark(#F5F9FC,#13202B);" vertex="1" parent="1"><mxGeometry x="770" y="190" width="200" height="110" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Model&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Record the process in process-model.md&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="190" width="200" height="110" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Draw&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Draw the swimlane diagram with the draw.io MCP server&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="200" height="110" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Review&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Walk every path with the user, including failure paths&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="490" width="200" height="110" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Department forms&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Collect review answers from each department&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="490" width="200" height="110" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;Iterate&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Update the model, redraw, record the changes&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="490" width="200" height="110" as="geometry" /></mxCell><mxCell id="c10" value="Done" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fillStyle=auto;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="1090" y="513" width="140" height="64" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#545B64,#B0B8C1);fontColor=light-dark(#232F3E,#F5F5F5);labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1