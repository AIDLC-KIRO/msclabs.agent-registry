;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930.0" y="370.0" /><mxPoint x="1130.0" y="370.0" /></Array></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;bpmn_validate&lt;/b&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;after every draw, then check the exported image&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF4E5,#3D2A00);fillStyle=auto;strokeColor=#FF9900;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="200" height="60" as="geometry" /></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#545B64,#B0B8C1);fontColor=light-dark(#232F3E,#F5F5F5);labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;strokeColor=#FF9900;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Session tool cycle&lt;/b&gt;&lt;br&gt;Each step: &lt;b&gt;bpmn_step_get&lt;/b&gt; serves the instructions, the local assistant does the work, then &lt;b&gt;bpmn_step_submit&lt;/b&gt; records the result. No user gates.&lt;br&gt;Skip the interview with &lt;b&gt;bpmn_step_skip&lt;/b&gt; when the user wants to go straight to drawing.&lt;br&gt;Any time: &lt;b&gt;bpmn_session_status&lt;/b&gt; and &lt;b&gt;bpmn_run_log&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);fillStyle=auto;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=12;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="50" y="740" width="810" height="120" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="890" y="740" width="120" height="22" as="geometry" /></mxCell><mxCell id="c34" value="Step" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="890" y="770" width="80" height="34" as="geometry" /></mxCell><mxCell id="c35" value="Optional" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;dashed=1;dashPattern=6 4;fillColor=light-dark(#F5F9FC,#13202B);fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="985" y="770" width="80" height="34" as="geometry" /></mxCell><mxCell id="c36" value="Start / end" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fillStyle=auto;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="770" width="90" height="34" as="geometry" /></mxCell><mxCell id="c37" value="Dashed arrow: loop back, skip or read-only" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="890" y="820" width="380" height="22" as="geometry" /></mxCell><mxCell id="title-group" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="1"><mxGeometry x="50" y="30" width="1180" height="83" as="geometry" /></mxCell><mxCell id="title-text" value="aidlc.bpmn-creator: workflow" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="0" y="0" width="1170" height="42" as="geometry" /></mxCell><mxCell id="subtitle-text" value="8 steps, no gates. The interview is optional and the review loop repeats until the diagram matches the real work" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="40" width="1170" height="25" as="geometry" /></mxCell><mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="70" width="1170" height="10" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
