<mxfile host="drawio" agent="aws-architecture-diagram"><diagram id="devsecops-cicd-workflow" name="devsecops-cicd-workflow"><mxGraphModel dx="1620" dy="910" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1620" pageHeight="910" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="Start&lt;div style=&quot;font-weight: normal; font-size: 11px;&quot;&gt;cicd_start&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fillStyle=auto;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="50" y="213" width="140" height="64" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;Plan&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Confirm the application name and language&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="200" height="110" as="geometry" /></mxCell><mxCell id="c3" value="Gate 1&lt;div style=&quot;font-weight: normal;&quot;&gt;user OK&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF4E5,#3D2A00);fillStyle=auto;strokeColor=#FF9900;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="510" y="205" width="110" height="80" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Get resources&lt;/b&gt;&lt;div style=&quot;font-size: 11px; margin-top: 4px;&quot;&gt;Local read-only discovery of the account and pipeline&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A