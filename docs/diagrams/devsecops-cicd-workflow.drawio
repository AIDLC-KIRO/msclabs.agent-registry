n=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1358" y="178" width="28" height="28" as="geometry" /></mxCell><mxCell id="c33" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="38" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c34" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="468" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c35" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="728" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="c36" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="988" y="478" width="28" height="28" as="geometry" /></mxCell><mxCell id="e37" value="push, observe, diagnose, fix (cicd_run_log)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#545B64,#B0B8C1);fontColor=light-dark(#232F3E,#F5F5F5);labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;strokeColor=#007CBD;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900.0" y="450" /><mxPoint x="780.0" y="450" /></Array></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Stop and escalate&lt;/b&gt;&lt;div style=&quot;font-size: 11px;&quot;&gt;same failure 3 times: hand back to the team&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFEBEE,#3A1015);fillStyle=auto;strokeColor=#DD344C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="740" y="650" width="200" height="64" as="geometry" /></mxCell><mxCell id="e39" value="3x same failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=light-dark(#545B64,#B0B8C1);fontColor=light-dark(#232F3E,#F5F5F5);labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;strokeColor=#DD344C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;Session tool cycle&lt;/b&gt;&lt;br&gt;Each step: &lt;b&gt;cicd_step_get&lt;/b&gt; serves the instructions, the local assistant does the work in the workspace, then &lt;b&gt;cicd_step_submit&lt;/b&gt; records the result.&lt;br&gt;At a gate: &lt;b&gt;cicd_gate_confirm&lt;/b&gt; records the user&#x27;s decision before the next step unlocks.&lt;br&gt;Any time: &lt;b&gt;cicd_session_status&lt;/b&gt; and &lt;b&gt;cicd_run_log&lt;/b&gt;.&lt;br&gt;Validate every file with &lt;b&gt;cicd_changeset_validate&lt;/b&gt; before writing it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);fillStyle=auto;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacing=12;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="50" y="750" width="1150" height="120" as="geometry" /></mxCell><mxCell id="c41" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="1230" y="750" width="120" height="22" as="geometry" /></mxCell><mxCell id="c42" value="Step" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1230" y="780" width="80" height="34" as="geometry" /></mxCell><mxCell id="c43" value="Optional" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=light-dark(#E6F2FA,#0B2A3D);fillStyle=auto;strokeColor=#007CBD;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;spacing=10;spacingTop=6;dashed=1;dashPattern=6 4;fillColor=light-dark(#F5F9FC,#13202B);fontSize=11;spacing=2;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1325" y="780" width="80" height="34" as="geometry" /></mxCell><mxCell id="c44" value="Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=light-dark(#FFF4E5,#3D2A00);fillStyle=auto;strokeColor=#FF9900;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;" vertex="1" parent="1"><mxGeometry x="1420" y="776" width="70" height="44" as="geometry" /></mxCell><mxCell id="c45" value="Start / end" style="ellipse;whiteSpace=wrap;html=1;fillColor=light-dark(#E8F5E9,#0F2E14);fillStyle=auto;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=light-dark(#232F3E,#F5F5F5);shadow=1;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1505" y="780" width="90" height="34" as="geometry" /></mxCell><mxCell id="c46" value="Dashed arrow: loop back, skip or read-only" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F5F5F5);" vertex="1" parent="1"><mxGeometry x="1230" y="830" width="380" height="22" as="geometry" /></mxCell><mxCell id="title-group" value="" style="group;fontFamily=Helvetica;" vertex="1" connectable="0" parent="1"><mxGeometry x="50" y="30" width="1520" height="83" as="geometry" /></mxCell><mxCell id="title-text" value="aidlc.devsecops-cicd: workflow" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="0" y="0" width="1510" height="42" as="geometry" /></mxCell><mxCell id="subtitle-text" value="8 steps and 3 user gates. The hosted server serves each step; the local assistant does the work and nothing is pushed without the team&#x27;s approval" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="40" width="1510" height="25" as="geometry" /></mxCell><mxCell id="title-separator" value="" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="title-group"><mxGeometry x="5" y="70" width="1510" height="10" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
