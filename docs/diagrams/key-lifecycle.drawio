<mxfile host="drawio"><diagram id="key-lifecycle" name="key-lifecycle"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="API key lifecycle: issue, connect, expire" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Every new key carries an expiry date (7, 30, 60, 90 days or a custom date). A daily job at 00:00 Asia/Bangkok revokes keys past their date. Keys issued before expiry existed never expire." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1420" height="24" as="geometry"/></mxCell><mxCell id="g-owner" value="Service owner" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F7F9FB;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="450" as="geometry"/></mxCell><mxCell id="g-aws" value="AWS Cloud: hosted MCP registry (ap-southeast-7)" style="outlineConnect=0;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="700" height="450" as="geometry"/></mxCell><mxCell id="g-user" value="Consumer machine" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F7F9FB;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontFamily=Helvetica;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1160" y="110" width="300" height="450" as="geometry"/></mxCell><mxCell id="owner" value="Administrator" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="166" y="160" width="48" height="48" as="geometry"/></mxCell><mxCell id="console" value="Admin console&lt;br&gt;(sign-in, admin group)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.generic_application;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="166" y="330" width="48" height="48" as="geometry"/></mxCell><mxCell id="apigw" value="API Gateway&lt;br&gt;usage plan + API keys" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;spacingRight=4;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="48" height="48" as="geometry"/></mxCell><mxCell id="servers" value="aidlc.* MCP servers&lt;br&gt;(AWS Lambda)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="48" height="48" as="geometry"/></mxCell><mxCell id="sched" value="EventBridge Scheduler&lt;br&gt;cron(0 0 * * ? *)&lt;br&gt;Asia/Bangkok" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="48" height="48" as="geometry"/></mxCell><mxCell id="lambda" value="Lambda expire-keys&lt;br&gt;(disables, never deletes)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="48" height="48" as="geometry"/></mxCell><mxCell id="kiro" value="Kiro / MCP client&lt;br&gt;mcp.json: uvx or url" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.generic_application;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1286" y="266" width="48" height="48" as="geometry"/></mxCell><mxCell id="e1" value="issue key&lt;br&gt;+ expiry date" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="owner" target="console"><mxGeometry x="0" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="create key, add to plan,&lt;br&gt;expiresAt in key notes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="console" target="apigw"><mxGeometry x="0" y="-22" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="servers"><mxGeometry x="0.2" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="daily&lt;br&gt;00:00 BKK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sched" target="lambda"><mxGeometry x="-0.45" y="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="disable keys past expiresAt&lt;br&gt;revokedBy=expiry-scheduler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="apigw"><mxGeometry x="0" y="-22" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="HTTPS + x-api-key (until revoked)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kiro" target="apigw"><mxGeometry x="0.3" y="-12" relative="1" as="geometry"><Array as="points"><mxPoint x="524" y="290"/></Array></mxGeometry></mxCell><mxCell id="e3" value="hand over key + mcp.json (selected servers, uvx or URL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="console" target="kiro"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="354"/><mxPoint x="90" y="600"/><mxPoint x="1430" y="600"/><mxPoint x="1430" y="290"/></Array></mxGeometry></mxCell><mxCell id="s1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="250" width="30" height="28" as="geometry"/></mxCell><mxCell id="s2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="30" height="28" as="geometry"/></mxCell><mxCell id="s3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="586" width="30" height="28" as="geometry"/></mxCell><mxCell id="s4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="262" width="30" height="28" as="geometry"/></mxCell><mxCell id="s5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="226" width="30" height="28" as="geometry"/></mxCell><mxCell id="s6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="382" width="30" height="28" as="geometry"/></mxCell><mxCell id="l1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt1" value="&lt;b&gt;Issue&lt;/b&gt;&lt;br&gt;An administrator issues a key with an expiry date. Revoke and delete stay manual actions in the console." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="636" width="420" height="70" as="geometry"/></mxCell><mxCell id="l2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="515" y="640" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt2" value="&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;The key joins the registry usage plan. The date is kept in the key notes, because API Gateway keys have no expiry field." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="555" y="636" width="420" height="70" as="geometry"/></mxCell><mxCell id="l3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="640" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt3" value="&lt;b&gt;Hand over&lt;/b&gt;&lt;br&gt;The console generates mcp.json for the selected servers, uvx (default) or direct URL, referring to MCP_API_TOKEN." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="636" width="420" height="70" as="geometry"/></mxCell><mxCell id="l4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt4" value="&lt;b&gt;Use&lt;/b&gt;&lt;br&gt;The client calls the hosted servers with the key in x-api-key until the key is revoked." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="716" width="420" height="70" as="geometry"/></mxCell><mxCell id="l5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="515" y="720" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt5" value="&lt;b&gt;Daily check&lt;/b&gt;&lt;br&gt;EventBridge Scheduler starts the expiry job every day at 00:00 Asia/Bangkok." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="555" y="716" width="420" height="70" as="geometry"/></mxCell><mxCell id="l6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="990" y="720" width="30" height="28" as="geometry"/></mxCell><mxCell id="lt6" value="&lt;b&gt;Expire&lt;/b&gt;&lt;br&gt;The job disables every key past its date. The key then gets 403, and the owner issues a replacement." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="716" width="420" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>